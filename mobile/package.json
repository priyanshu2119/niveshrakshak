{
  "name": "niveshrakshak-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "NiveshRakshak Android shell — Capacitor 8 wrapper around the existing vanilla-JS frontend. webDir points at ../web, the same assets the hosted site serves, so there is one frontend and no drift.",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "build": "cd android && ./gradlew assembleRelease",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "adb:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "adb:devices": "adb devices -l"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor-mlkit/text-recognition": "8.2.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/camera": "8.2.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@capgo/capacitor-share-target": "8.0.54"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
